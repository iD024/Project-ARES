# ARES Planetary Exploration Platform Environment Configuration
VITE_APP_NAME="ARES — Advanced Reconnaissance and Exploration System"
VITE_APP_VERSION="0.1.0"

# Optional ArcGIS API Key (not required for open public planetary layers)
# VITE_ARCGIS_API_KEY=""

# NASA Mars Trek WMTS Base Endpoint
VITE_NASA_TREK_WMTS_BASE="https://trek.nasa.gov/tiles/Mars/EQ"

# USGS Astrogeology Planetary WMS Base Endpoint
VITE_USGS_WMS_BASE="https://planetarymaps.usgs.gov/cgi-bin/mapserv?map=/maps/mars/mars_simp_cyl.map"

